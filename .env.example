# ==========================================================================
#  LLM Provider 配置
# ==========================================================================
# 你可以在 .env 文件中设置以下变量（从 .env.example 复制并重命名为 .env）

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- OpenAI (GPT) ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek ---
# DeepSeek API 兼容 OpenAI 格式，使用 ChatOpenAI + base_url 即可
# 官方 API: https://api.deepseek.com
# 本地 ccswitch 代理: http://localhost:xxxx/v1
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 通用 ---
# 默认使用的 LLM Provider: anthropic | openai | deepseek
LLM_PROVIDER=deepseek

# --- 公告研读 Agent（可选覆盖）---
ANNOUNCE_SOURCE=cninfo
ANNOUNCE_MAX_DOCUMENTS=120
ANNOUNCE_OFFLINE_ENABLED=true
OCR_ENABLED=true
EMBEDDING_BACKEND=fallback
EMBEDDING_ALLOW_DOWNLOAD=false
FINBERT_ENABLED=false
FINBERT_GATE_ENABLED=false
# 训练同口径实时 F1（BGE CLS→主题召回→reranker→FinBERT→冻结 PCA50）
# auto：仅当下面三套本地路径均存在时启用；true：允许 HuggingFace 首次下载。
F1_ONLINE_SEMANTICS_ENABLED=auto
# F1_BGE_MODEL_PATH=D:\models\bge-large-zh-v1.5
# F1_RERANK_MODEL_PATH=D:\models\bge-reranker-v2-m3
# F1_FINBERT_MODEL_PATH=D:\models\finbert-tone-chinese
# F1_ONLINE_BATCH_SIZE=32
# 默认读取仓库内“公告解析”可移植数据包，无需设置路径。
# 仅在本机持有完整 Announcement_NLP_Project_Final 时取消下一行注释并修改：
# COMPETITION_DATA_ROOT=D:\your-path\Announcement_NLP_Project_Final
# 下列两个文件通常无需单独设置；仅在目录结构变化时覆盖（支持 .jsonl.gz）
# COMPETITION_RULE_RISKS=D:\path\announcement_rule_risks.jsonl.gz
# COMPETITION_SEMANTIC_FEATURES=D:\path\semantic_features.parquet

# --- 本机外部数据根目录（可选覆盖）---
# 默认 DATA_ROOT=D:\BaiduNetdiskDownload、INQUIRY_ROOT=D:\新建文件夹。
# 若你的外部数据放在其他盘，只需改这两个根，其余路径（财务/案例/问询/chunk 等）会自动从根派生：
# DATA_ROOT=D:\your-external-data
# INQUIRY_ROOT=D:\your-inquiry-data
