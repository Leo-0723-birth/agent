# ==========================================================================
#  LLM Provider 配置
# ==========================================================================
# 你可以在 .env 文件中设置以下变量（从 .env.example 复制并重命名为 .env）

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- OpenAI (GPT) ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek ---
# DeepSeek API 兼容 OpenAI 格式，使用 ChatOpenAI + base_url 即可
# 官方 API: https://api.deepseek.com
# 本地 ccswitch 代理: http://localhost:xxxx/v1
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 通用 ---
# 默认使用的 LLM Provider: anthropic | openai | deepseek
LLM_PROVIDER=deepseek

# --- 公告研读 Agent（可选覆盖）---
ANNOUNCE_SOURCE=cninfo
ANNOUNCE_MAX_DOCUMENTS=120
OCR_ENABLED=true
EMBEDDING_BACKEND=fallback
FINBERT_ENABLED=false
FINBERT_GATE_ENABLED=false
# 比赛历史库根目录；团队成员按自己的实际存放位置修改
COMPETITION_DATA_ROOT=D:\codex work\Announcement_NLP_Project_Final
# 下列两个文件通常无需单独设置；仅在目录结构变化时覆盖
# COMPETITION_RULE_RISKS=D:\path\announcement_rule_risks.jsonl
# COMPETITION_SEMANTIC_FEATURES=D:\path\semantic_features.parquet
